# VIP Stripe checkout (PRE / preview only). Never set these on Vercel Production.
# Prefer NEXT_PUBLIC_STRIPE_PAYMENT_LINK or VIP_CHECKOUT_URL in Vercel PRE.
# If missing, the test Payment Link is used only in development, Vercel preview,
# rama `pre`, or when NEXT_PUBLIC_VIP_CHECKOUT_ENABLED=true (ignored on Production).
# NEXT_PUBLIC_STRIPE_PAYMENT_LINK=https://buy.stripe.com/test_eVq00l7Wx4Z20YM2REgnK00
# VIP_CHECKOUT_URL=
# NEXT_PUBLIC_VIP_CHECKOUT_ENABLED=true

# Avisos al administrador cuando alguien se apunta por correo.
# Si no se definen, se usan los webhooks n8n genéricos del VPS.
# ALERTAS_WEBHOOK_TELEGRAM=https://vps-faf1945e.vps.ovh.net/webhook/generico-telegram
# ALERTAS_WEBHOOK_EMAIL=https://vps-faf1945e.vps.ovh.net/webhook/generico-email
# ALERTAS_WEBHOOK_PUSH=https://vps-faf1945e.vps.ovh.net/webhook/generico-web-push
# Respaldo si no hay una URL por canal:
# N8N_WEBHOOK_ALERTAS=
# ALERTAS_TELEGRAM_CHAT_ID=-1004437925569
# ALERTAS_ADMIN_EMAIL=avilesia2026@gmail.com
# Solo si no hay webhook de ese canal:
# TELEGRAM_BOT_TOKEN=
# ONESIGNAL_REST_API_KEY=

# Bloque in-feed de AdSense entre tarjetas. Si falta o está vacío, no se renderiza el <ins>.
# NEXT_PUBLIC_ADSENSE_SLOT=

# VIP Customer Portal (PRE / test only). Never sk_live_.
# STRIPE_SECRET_KEY=sk_test_...
